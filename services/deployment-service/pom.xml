<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.arijit</groupId>
        <artifactId>arceus-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>deployment-service</artifactId>
    <packaging>jar</packaging>
    <name>deployment-service</name>
    <description>
        Arceus Deployment Service - the centralized deployment management
        platform for every Arceus service across every environment: create/
        update/rollback a deployment, gate it behind approval where the
        environment requires one, validate it (version/config/env-vars/
        dependencies) before touching anything, verify health before and
        after, and track the full release history. Exposes REST and gRPC
        surfaces, same as every other platform service.

        Deliberately does NOT talk to Kubernetes, Helm, Terraform, Ansible,
        Docker Swarm, or a GitOps controller, and does not implement
        blue-green or canary rollout strategies yet - see DeploymentExecutor,
        which is the seam a future orchestrator-backed executor would
        implement without any change to this service's public REST/gRPC
        contracts (same pattern as scheduler-service's JobExecutor).

        Never runs its own health-polling loop - monitoring-service is
        already the platform's single source of truth for "is this service
        healthy right now" (DB/cache/RabbitMQ/gRPC/API availability), so
        DeploymentHealthVerificationService calls it over gRPC instead of
        duplicating that polling here.
    </description>

    <properties>
        <springdoc.version>2.8.5</springdoc.version>
    </properties>

    <dependencies>
        <!-- gRPC server: exposes DeploymentGrpcService for in-cluster
             callers that want a fast, typed path to CreateDeployment/
             DeployService/RollbackDeployment/GetDeployment/ListDeployments/
             GetDeploymentHistory instead of the REST API. Approve/Cancel
             are deliberately REST-only - see deployment.proto's Javadoc. -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-server-spring-boot-starter</artifactId>
            <version>${grpc-spring.version}</version>
        </dependency>
        <!-- gRPC client: calls monitoring-service (pre/post-deploy health
             verification - see DeploymentHealthVerificationService) and
             scheduler-service (registers the HTTP_CALLBACK job behind a
             scheduled deployment - see DeploymentSchedulingService). -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-client-spring-boot-starter</artifactId>
            <version>${grpc-spring.version}</version>
        </dependency>
        <dependency>
            <groupId>com.arijit</groupId>
            <artifactId>arceus-grpc-contracts</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.arijit</groupId>
            <artifactId>arceus-events</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Own database: deployment records, one row per create/rollback
             attempt, which is also this service's release history. Per the
             platform rule "services never access another service's
             database", this is a separate schema from every other
             service's. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>springboot3-dotenv</artifactId>
            <version>5.0.1</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
