# Copy this file to .env and fill in real values. .env is gitignored — this
# template is the only version that should ever be committed.

# ---------- Postgres (auth-service, notification-service, audit-service - one DB each, same instance) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arceus_auth
NOTIFICATION_DB_NAME=arceus_notification
AUDIT_DB_NAME=arceus_audit
DB_USERNAME=postgres
DB_PASSWORD=

# ---------- Redis (shared) ----------
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ---------- RabbitMQ / CloudAMQP (shared) ----------
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=

# ---------- Gmail SMTP (shared) ----------
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# ---------- Google OAuth2 (auth-service only) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- GitHub OAuth2 (auth-service only) ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- JWT (auth-service only) ----------
JWT_SECRET=

# ---------- OAuth2 redirect (auth-service only) ----------
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback

# ---------- 2Factor.in SMS (shared) ----------
TWOFACTOR_API_KEY=
