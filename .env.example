# Copy this file to .env and fill in real values. .env is gitignored — this
# template is the only version that should ever be committed.
#
# Running via `docker compose up` already has sane demo defaults baked in
# and does NOT need this file — it's for running services individually
# with `mvnw spring-boot:run` instead.

# ---------- Postgres (auth, notification, scheduler, feature-flag, organization, monitoring - one DB each, same instance) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arceus_auth
NOTIFICATION_DB_NAME=arceus_notification
SCHEDULER_DB_NAME=arceus_scheduler
FEATURE_FLAG_DB_NAME=arceus_feature_flag
ORGANIZATION_DB_NAME=arceus_organization
MONITORING_DB_NAME=arceus_monitoring
DB_USERNAME=postgres
DB_PASSWORD=

# ---------- Redis (shared) ----------
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ---------- RabbitMQ / CloudAMQP (shared) ----------
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=

# ---------- Gmail SMTP (shared) ----------
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# ---------- Arceus Notification Service ----------
# Shared secret scheduler-service's HTTP_CALLBACK executor presents when it
# calls back into /internal/notifications/retry-failed - see
# notification-service's RetryCallbackController / RetryJobRegistrar.
NOTIFICATION_INTERNAL_API_TOKEN=changeme-notification-internal-token
# Must be reachable from scheduler-service's pod/host, not just this service's own network.
NOTIFICATION_CALLBACK_BASE_URL=http://localhost:8082
# Environment notification-service evaluates feature flags in - see ChannelFlagGateService.
NOTIFICATION_FEATURE_FLAG_ENVIRONMENT=PRODUCTION

# ---------- Google OAuth2 (auth-service only) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- GitHub OAuth2 (auth-service only) ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- JWT (auth-service issues; gateway-service verifies with the same secret) ----------
JWT_SECRET=

# Environment gateway-service evaluates feature flags in - see RouteFlagGatewayClient.
GATEWAY_FEATURE_FLAG_ENVIRONMENT=PRODUCTION

# ---------- OAuth2 redirect (auth-service only) ----------
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback

# ---------- Arceus Auth Service internal ----------
# Shared secret scheduler-service's HTTP_CALLBACK executor presents when it
# calls back into /internal/auth/sessions/clean-expired - see
# SessionCleanupCallbackController / SessionCleanupJobRegistrar.
AUTH_INTERNAL_API_TOKEN=changeme-auth-internal-token
# AES-256 key, 32 raw bytes base64-encoded - lets a previously-created API
# key be decrypted and shown again later (see ApiKeyCryptoService's
# javadoc for what that trades away versus the usual hash-only design).
# Generate a real one with: openssl rand -base64 32
AUTH_API_KEY_ENCRYPTION_KEY=changeme-generate-with-openssl-rand-base64-32
# Must be reachable from scheduler-service's pod/host, not just this service's own network.
AUTH_CALLBACK_BASE_URL=http://localhost:8081
# How often the "clean expired sessions" job fires, in milliseconds.
AUTH_SESSION_CLEANUP_INTERVAL_MS=3600000
# Environment auth-service evaluates feature flags in - see FeatureFlagGateService.
AUTH_FEATURE_FLAG_ENVIRONMENT=PRODUCTION
# Bootstraps a super-admin account on first startup if both are set - never
# touches an existing account on later restarts.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---------- 2Factor.in SMS (shared) ----------
TWOFACTOR_API_KEY=

# ---------- Arceus Gateway ----------
GATEWAY_PORT=8090
# How many requests a single authenticated identity may make per window,
# across ANY protected route, before the Gateway itself returns 429 - on
# top of (not instead of) each service's own fine-grained @RateLimited rules.
GATEWAY_RATE_LIMIT=100
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60

# ---------- gRPC ports (Gateway -> Service) ----------
# Each service exposes its REST API on server.port (see above) and, in
# parallel, a gRPC server on these ports for the Gateway to call.
AUTH_GRPC_HOST=localhost
AUTH_GRPC_PORT=9081
NOTIFICATION_GRPC_HOST=localhost
NOTIFICATION_GRPC_PORT=9082
RATELIMIT_GRPC_HOST=localhost
RATELIMIT_GRPC_PORT=9084
SCHEDULER_GRPC_HOST=localhost
SCHEDULER_GRPC_PORT=9086
FEATURE_FLAG_GRPC_HOST=localhost
FEATURE_FLAG_GRPC_PORT=9087

# ---------- Arceus Scheduler Service ----------
# Shared secret every internal caller (REST or gRPC) must present - see
# InternalTokenAuthFilter / GrpcAuthInterceptor. Must match exactly on
# every calling service's side too.
SCHEDULER_INTERNAL_API_TOKEN=changeme-scheduler-internal-token
# Environment scheduler-service evaluates feature flags in - see JobFlagGateService.
SCHEDULER_FEATURE_FLAG_ENVIRONMENT=PRODUCTION

# ---------- Arceus Feature Flag Service ----------
FEATURE_FLAG_PORT=8087
# Shared secret every internal caller (REST or gRPC) must present - see
# InternalTokenAuthFilter / GrpcAuthInterceptor in feature-flag-service.
# Also what scheduler-service's HTTP_CALLBACK jobs present when they call
# back in to activate/deactivate a scheduled flag.
FEATURE_FLAG_INTERNAL_API_TOKEN=changeme-feature-flag-internal-token
# TTL for cached flag evaluations (see FlagCacheService) - 0 disables caching.
FEATURE_FLAG_CACHE_TTL_SECONDS=60
FEATURE_FLAG_CACHE_ENABLED=true
# Delegates scheduled activation/deactivation to scheduler-service - see FlagSchedulingService.
FEATURE_FLAG_SCHEDULING_ENABLED=true
# Must be reachable from scheduler-service's pod/host, not just this service's own network.
FEATURE_FLAG_CALLBACK_BASE_URL=http://localhost:8087

# ---------- Arceus Monitoring Service ----------
MONITORING_PORT=8088
MONITORING_GRPC_PORT=9088
MONITORING_DB_NAME=arceus_monitoring
# Shared secret every internal caller (REST or gRPC) must present - see
# InternalTokenAuthFilter / GrpcAuthInterceptor in monitoring-service.
MONITORING_INTERNAL_API_TOKEN=changeme-monitoring-internal-token
# How often ServicePollingService sweeps every monitored service, and the
# per-request Actuator call timeout applied while doing so.
MONITORING_POLLING_INTERVAL_MS=15000
MONITORING_POLLING_TIMEOUT_MS=2000
# Starting thresholds for the built-in alert rules seeded on first startup -
# every rule stays editable afterwards via PUT /alerts/{id}.
MONITORING_THRESHOLD_CPU_PERCENT=80
MONITORING_THRESHOLD_MEMORY_PERCENT=85
MONITORING_THRESHOLD_ERROR_RATE_PERCENT=5
MONITORING_THRESHOLD_RESPONSE_TIME_MS=1000
MONITORING_HISTORY_RETENTION_DAYS=30
# Base URLs monitoring-service polls /actuator/health and /actuator/metrics/*
# on - one per monitored service (see monitoring-service's application.yml).
GATEWAY_BASE_URL=http://localhost:8090
AUTH_BASE_URL=http://localhost:8081
NOTIFICATION_BASE_URL=http://localhost:8082
RATELIMIT_BASE_URL=http://localhost:8084
CACHE_BASE_URL=http://localhost:8085
SCHEDULER_BASE_URL=http://localhost:8086
FEATURE_FLAG_BASE_URL=http://localhost:8087

# ---------- Arceus Cache Service internal ----------
CACHE_GRPC_PORT=9085
# Shared secret scheduler-service's HTTP_CALLBACK executor presents when it
# calls back into /internal/cache/sweep - see SweepCallbackController / SweepJobRegistrar.
CACHE_INTERNAL_API_TOKEN=changeme-cache-internal-token
# Must be reachable from scheduler-service's pod/host, not just this service's own network.
CACHE_CALLBACK_BASE_URL=http://localhost:8085
# How long a NO_EXPIRY entry can go unwritten before the sweep evicts it.
CACHE_SWEEP_NO_EXPIRY_STALE_AFTER_SECONDS=2592000
# How often the sweep job fires.
CACHE_SWEEP_INTERVAL_MS=86400000

# ---------- Arceus Organization Service ----------
# Owns the Developer Portal's tenant hierarchy - Organization/Project/
# Environment/ModuleEnablement/Secret. Trusts the Gateway as its edge the
# same way auth/notification/cache do (no internal gRPC token required for
# its own inbound traffic - unlike monitoring/scheduler/feature-flag).
#
# Enabling/disabling a module calls straight through to the one service
# that module maps to (AUTHENTICATION->auth-service, NOTIFICATION->
# notification-service, CACHE->cache-service, SCHEDULER->scheduler-service,
# FEATURE_FLAGS->feature-flag-service) via each one's ProvisionTenant/
# DeprovisionTenant RPC - see ModuleProvisioningClient's javadoc. Reuses
# the AUTH_GRPC_*/NOTIFICATION_GRPC_*/etc. host:port vars already defined
# above; the two tokened targets (scheduler/feature-flag) reuse those
# services' own *_INTERNAL_API_TOKEN values below - must match exactly.
ORGANIZATION_PORT=8091
ORGANIZATION_GRPC_PORT=9090
ORGANIZATION_DB_NAME=arceus_organization
CACHE_GRPC_HOST=localhost
CACHE_GRPC_PORT=9085
# AES-256 key, 32 raw bytes base64-encoded, used to encrypt every Secret
# row - see SecretCryptoService. Generate a real one per environment with:
#   openssl rand -base64 32
# The committed default in application.yml is an obviously-fake all-zero
# key for local dev only - always override this in staging/production.
ORGANIZATION_SECRETS_KEK=changeme-generate-with-openssl-rand-base64-32
ARCEUS_GATEWAY_BASE_URL=http://localhost:8090

# ---------- CORS ----------
# Comma-separated origins allowed to call the Gateway from a browser -
# the Portal (3000) and the standalone consumer demo in demo/ (4300, see
# demo/README.md for how it's served). Add any other origin you serve
# either from.
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4300

# ---------- Gateway-level API key auth ----------
# No new env vars needed here - ApiKeyAuthFilter reuses the existing
# auth-service gRPC channel already configured above. A request presenting
# X-API-Key is authenticated at the Gateway itself.
