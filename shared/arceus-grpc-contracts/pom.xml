<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.arijit</groupId>
        <artifactId>arceus-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>arceus-grpc-contracts</artifactId>
    <packaging>jar</packaging>
    <name>arceus-grpc-contracts</name>
    <description>
        Shared .proto contracts and generated gRPC stubs for Gateway to Service
        communication (Auth, Notification, Audit, RateLimiter). Depended on by
        the gateway-service and by every service it talks to over gRPC.
    </description>

    <properties>
        <!-- Boot 3.5 doesn't manage io.grpc/protobuf versions via BOM (that
             only started with Boot 4.1), so every version here is pinned
             explicitly. grpc 1.68.1 / protobuf-java 3.25.5 is a long-stable,
             widely-deployed pairing - protoc and protoc-gen-grpc-java are
             kept in lockstep with those same versions for wire compatibility. -->
        <grpc.version>1.68.1</grpc.version>
        <protobuf.version>3.25.5</protobuf.version>
        <protoc.version>${protobuf.version}</protoc.version>
        <protoc-gen-grpc-java.version>${grpc.version}</protoc-gen-grpc-java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <!-- grpc-java's generated *Grpc.java classes are annotated with the
             old @javax.annotation.Generated (JSR-250), not the newer
             jakarta.annotation.Generated the dependency above provides -
             two different packages, both needed. javax.annotation.Generated
             was removed from the JDK itself in Java 9, so without this the
             generated sources fail to compile with "cannot find symbol". -->
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>5.0.1</version>
                <configuration>
                    <protoc>${protoc.version}</protoc>
                    <plugins>
                        <plugin kind="binary-maven">
                            <groupId>io.grpc</groupId>
                            <artifactId>protoc-gen-grpc-java</artifactId>
                            <version>${protoc-gen-grpc-java.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
